use deadlinepath;

fn main() {
    let budget = 100.0;
    let stages = [20, 35];
    let reserve = 10.0;
    let result = deadlinepath_remaining(budget, stages, reserve);
    if len(result) == 0 { println!("invalid"); return; }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
